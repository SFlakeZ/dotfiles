# Heavely based on: https://github.com/GitAlias/gitalias
[alias]
    # frequent aliases
    a = add
    b = branch
    c = commit
    d = diff
    f = fetch
    g = grep
    l = log
    m = merge
    p = pull
    rb = rebase
    s = status
    co = checkout
    sw = switch
    re = restore

    # add aliases
    au = add --update

    # commit aliases
    ca = commit --amend
    cane = commit --amend --no-edit
    caa = commit --amend --all
    caane = commit --amend --all --no-edit

    # branch aliases
    swc = switch --create
    bd = branch --delete
    bdd = branch -D

