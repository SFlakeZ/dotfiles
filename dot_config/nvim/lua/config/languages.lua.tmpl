{{- $languages := list -}}
{{- if hasKey . "nvim_languages" -}}
{{-   $languages = .nvim_languages -}}
{{- else -}}
{{-   $languages = (index .packs (index . "pack" | default "standard")).nvim_languages -}}
{{- end -}}
-- Generated by chezmoi, edit 'nvim_languages' in ~/.config/chezmoi/chezmoi.toml
-- (default per pack in .chezmoidata/packs.toml)
--
-- Languages from tools.lua that are set up: lsp, linters, formatters,
-- treesitter parsers and, for install = "mason", the mason packages
return {
{{- range $languages }}
  {{ . | quote }},
{{- end }}
}
